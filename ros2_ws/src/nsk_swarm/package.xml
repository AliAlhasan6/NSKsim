<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nsk_swarm</name>
  <version>0.1.0</version>
  <description>
    NSK Swarm Robotics 2D Simulation — ROS 2 Jazzy + Gazebo Harmonic.
    Five differential-drive robots sharing compressed knowledge graphs
    via ROS 2 services. NSK inference runs in the nsk_engine node.
  </description>
  <maintainer email="aliyossefalhasan@gmail.com">Ali Alhasan</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <exec_depend>nsk_swarm_interfaces</exec_depend>
  <depend>geometry_msgs</depend>
  <!-- frontier_explorer queries the Nav2 servers' lifecycle get_state service
       before it dispatches its first goal (the readiness gate). -->
  <depend>lifecycle_msgs</depend>
  <!-- frontier_explorer imports ComputePathToPose directly for the reachability
       pre-check. It also arrives transitively via nav2_simple_commander, but a
       direct import needs a direct declaration. -->
  <depend>nav2_msgs</depend>
  <!-- frontier_explorer subscribes to global_costmap/costmap_updates for its
       costmap diagnostics; nav2 publishes those as map_msgs/OccupancyGridUpdate. -->
  <depend>map_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>ros_gz_bridge</depend>
  <depend>rviz2</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
